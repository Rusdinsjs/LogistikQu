  "query": "\n            SELECT i.id, i.adjustment_id, i.spare_part_id, p.part_name,\n                   i.qty_system, i.qty_physical, i.difference\n            FROM stock_adjustment_items i\n            JOIN spare_parts p ON i.spare_part_id = p.id\n            WHERE i.adjustment_id = $1\n            ",
