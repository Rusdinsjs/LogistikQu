  "query": "\n            SELECT i.id, i.transaction_id, i.spare_part_id, p.part_name,\n                   i.qty, i.unit_of_measure\n            FROM issue_transaction_items i\n            JOIN spare_parts p ON i.spare_part_id = p.id\n            WHERE i.transaction_id = $1\n            ",
