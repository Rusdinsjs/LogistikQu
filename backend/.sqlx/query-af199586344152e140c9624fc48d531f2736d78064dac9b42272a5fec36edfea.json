{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                m.id,\n                m.work_order_number,\n                m.equipment_id,\n                m.unit_number,\n                m.component_id,\n                c.name as \"component_name?\",\n                m.spare_part_id,\n                p.part_name as \"part_name?\",\n                m.failure_code,\n                m.failure_symptom,\n                m.maintenance_type,\n                m.hm_km,\n                m.parts_qty,\n                m.parts_cost,\n                m.labor_cost,\n                m.total_cost,\n                m.downtime_hours,\n                m.mechanic_name,\n                m.performed_at,\n                m.notes,\n                m.created_at\n            FROM equipment_maintenance_history m\n            LEFT JOIN equipment_components c ON m.component_id = c.id\n            LEFT JOIN spare_parts p ON m.spare_part_id = p.id\n            WHERE ($1 = '' OR m.equipment_id = $1 OR m.unit_number = $1)\n              AND ($2 = '' OR m.component_id = $2)\n              AND ($3 = '' OR m.spare_part_id = $3)\n              AND ($4 = '' OR m.failure_code ILIKE $5)\n            ORDER BY m.performed_at DESC\n            LIMIT $6 OFFSET $7\n            ",
