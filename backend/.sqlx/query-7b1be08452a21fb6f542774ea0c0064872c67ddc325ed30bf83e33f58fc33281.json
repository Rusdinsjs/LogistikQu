  "query": "\n            SELECT id, title, message, channel, trigger_type, reference_id, is_read, created_at\n            FROM notifications\n            WHERE (recipient_role LIKE '%ADMIN%' OR recipient_role = 'SUPERVISOR' OR recipient_role = 'SUPER_ADMIN')\n            ORDER BY created_at DESC\n            LIMIT 15\n            ",
