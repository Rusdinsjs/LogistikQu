{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT id, user_id, ip_address, user_agent, created_at, last_used_at, expires_at,\n                   (revoked_at IS NULL AND expires_at > NOW()) as \"is_active!\"\n            FROM refresh_tokens\n            WHERE user_id = $1\n            ORDER BY last_used_at DESC\n            LIMIT 20\n            ",
