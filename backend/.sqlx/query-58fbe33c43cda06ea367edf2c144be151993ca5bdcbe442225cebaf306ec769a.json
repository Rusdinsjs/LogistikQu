  "db_name": "PostgreSQL",
  "query": "\n            SELECT id, adjustment_number, warehouse_id, reason, notes,\n                   status, created_by, approved_by, approved_at, created_at\n            FROM stock_adjustments\n            WHERE ($1 = '' OR warehouse_id = $1)\n              AND warehouse_id = ANY($2)\n            ORDER BY created_at DESC\n            LIMIT 100\n            ",
